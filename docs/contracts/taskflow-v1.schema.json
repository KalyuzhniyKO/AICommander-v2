{
  "$defs": {
    "Design": {
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "$ref": "#/$defs/Requirements"
        },
        "components": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "requirements",
        "components"
      ],
      "title": "Design",
      "type": "object"
    },
    "DesignArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "integer"
        },
        "task_id": {
          "title": "Task Id",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "integer"
        },
        "status": {
          "const": "completed",
          "default": "completed",
          "title": "Status",
          "type": "string"
        },
        "input_artifact_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Input Artifact Ids",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "redacted": {
          "const": true,
          "default": true,
          "title": "Redacted",
          "type": "boolean"
        },
        "simulated": {
          "const": true,
          "default": true,
          "title": "Simulated",
          "type": "boolean"
        },
        "role": {
          "const": "architect",
          "title": "Role",
          "type": "string"
        },
        "type": {
          "const": "design",
          "title": "Type",
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/Design"
        }
      },
      "required": [
        "artifact_id",
        "task_id",
        "run_id",
        "input_artifact_ids",
        "created_at",
        "role",
        "type",
        "content"
      ],
      "title": "DesignArtifact",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "integer"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "from_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunState"
            },
            {
              "type": "null"
            }
          ]
        },
        "to_status": {
          "$ref": "#/$defs/RunState"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "action",
        "from_status",
        "to_status",
        "version",
        "reason",
        "created_at"
      ],
      "title": "Event",
      "type": "object"
    },
    "Plan": {
      "additionalProperties": false,
      "properties": {
        "design": {
          "$ref": "#/$defs/Design"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "execution": {
          "const": "not_executed",
          "default": "not_executed",
          "title": "Execution",
          "type": "string"
        }
      },
      "required": [
        "design",
        "steps"
      ],
      "title": "Plan",
      "type": "object"
    },
    "PlanArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "integer"
        },
        "task_id": {
          "title": "Task Id",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "integer"
        },
        "status": {
          "const": "completed",
          "default": "completed",
          "title": "Status",
          "type": "string"
        },
        "input_artifact_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Input Artifact Ids",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "redacted": {
          "const": true,
          "default": true,
          "title": "Redacted",
          "type": "boolean"
        },
        "simulated": {
          "const": true,
          "default": true,
          "title": "Simulated",
          "type": "boolean"
        },
        "role": {
          "const": "developer",
          "title": "Role",
          "type": "string"
        },
        "type": {
          "const": "plan",
          "title": "Type",
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/Plan"
        }
      },
      "required": [
        "artifact_id",
        "task_id",
        "run_id",
        "input_artifact_ids",
        "created_at",
        "role",
        "type",
        "content"
      ],
      "title": "PlanArtifact",
      "type": "object"
    },
    "Requirements": {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        }
      },
      "required": [
        "objective",
        "acceptance_criteria"
      ],
      "title": "Requirements",
      "type": "object"
    },
    "RequirementsArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "integer"
        },
        "task_id": {
          "title": "Task Id",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "integer"
        },
        "status": {
          "const": "completed",
          "default": "completed",
          "title": "Status",
          "type": "string"
        },
        "input_artifact_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Input Artifact Ids",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "redacted": {
          "const": true,
          "default": true,
          "title": "Redacted",
          "type": "boolean"
        },
        "simulated": {
          "const": true,
          "default": true,
          "title": "Simulated",
          "type": "boolean"
        },
        "role": {
          "const": "analyst",
          "title": "Role",
          "type": "string"
        },
        "type": {
          "const": "requirements",
          "title": "Type",
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/Requirements"
        }
      },
      "required": [
        "artifact_id",
        "task_id",
        "run_id",
        "input_artifact_ids",
        "created_at",
        "role",
        "type",
        "content"
      ],
      "title": "RequirementsArtifact",
      "type": "object"
    },
    "RunState": {
      "enum": [
        "planned",
        "running",
        "failed",
        "blocked",
        "awaiting_owner",
        "done",
        "cancelled"
      ],
      "title": "RunState",
      "type": "string"
    },
    "Stage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "analyst",
            "architect",
            "developer"
          ],
          "title": "Role",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/StageState"
        }
      },
      "required": [
        "role",
        "position",
        "status"
      ],
      "title": "Stage",
      "type": "object"
    },
    "StageState": {
      "enum": [
        "pending",
        "ready",
        "completed",
        "failed",
        "blocked",
        "cancelled"
      ],
      "title": "StageState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "integer"
    },
    "task_id": {
      "title": "Task Id",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/RunState"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    },
    "max_steps": {
      "title": "Max Steps",
      "type": "integer"
    },
    "steps_done": {
      "title": "Steps Done",
      "type": "integer"
    },
    "block_code": {
      "anyOf": [
        {
          "enum": [
            "manual",
            "step_limit",
            "role_failure",
            "owner_rejected"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Block Code"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "owner_decision": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "Owner Decision",
      "type": "string"
    },
    "director": {
      "const": "mock",
      "default": "mock",
      "title": "Director",
      "type": "string"
    },
    "simulated": {
      "const": true,
      "default": true,
      "title": "Simulated",
      "type": "boolean"
    },
    "completion_scope": {
      "const": "mock_artifacts_only",
      "default": "mock_artifacts_only",
      "title": "Completion Scope",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/Stage"
      },
      "title": "Stages",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "discriminator": {
          "mapping": {
            "design": "#/$defs/DesignArtifact",
            "plan": "#/$defs/PlanArtifact",
            "requirements": "#/$defs/RequirementsArtifact"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/RequirementsArtifact"
          },
          {
            "$ref": "#/$defs/DesignArtifact"
          },
          {
            "$ref": "#/$defs/PlanArtifact"
          }
        ]
      },
      "title": "Artifacts",
      "type": "array"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Timeline",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "status",
    "version",
    "max_steps",
    "steps_done",
    "block_code",
    "reason",
    "owner_decision",
    "created_at",
    "updated_at",
    "stages",
    "artifacts",
    "timeline"
  ],
  "title": "RunSnapshot",
  "type": "object"
}
