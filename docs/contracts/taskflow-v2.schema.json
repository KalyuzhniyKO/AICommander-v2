        },
        "verdict": {
          "enum": [
            "approve",
            "revise"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "scope": {
          "const": "planning_only",
          "default": "planning_only",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "plan",
        "verdict",
        "findings"
      ],
      "title": "PlanReview",
      "type": "object"
    },
    "RealPlan": {
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "$ref": "#/$defs/Requirements"
        },
        "design": {
          "anyOf": [
            {
              "$ref": "#/$defs/Design"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "execution": {
          "const": "not_executed",
          "default": "not_executed",
          "title": "Execution",
          "type": "string"
        }
      },
      "required": [
        "requirements",
        "steps"
      ],
      "title": "RealPlan",
      "type": "object"
    },
    "Requirements": {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        }
      },
      "required": [
        "objective",
        "acceptance_criteria"
      ],
      "title": "Requirements",
      "type": "object"
    },
    "RunState": {
      "enum": [
        "planned",
        "running",
        "failed",
        "blocked",
        "awaiting_owner",
        "done",
        "cancelled"
      ],
      "title": "RunState",
      "type": "string"
    },
    "StageState": {
      "enum": [
        "pending",
        "ready",
        "completed",
        "failed",
        "blocked",
        "cancelled"
      ],
      "title": "StageState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "integer"
    },
    "task_id": {
      "title": "Task Id",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/RunState"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    },
    "max_steps": {
      "title": "Max Steps",
      "type": "integer"
    },
    "steps_done": {
      "title": "Steps Done",
      "type": "integer"
    },
    "block_code": {
      "anyOf": [
        {
          "enum": [
            "manual",
            "step_limit",
            "role_failure",
            "owner_rejected"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Block Code"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "owner_decision": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "Owner Decision",
      "type": "string"
    },
    "director": {
      "const": "hermes",
      "default": "hermes",
      "title": "Director",
      "type": "string"
    },
    "simulated": {
      "const": false,
      "default": false,
      "title": "Simulated",
      "type": "boolean"
    },
    "completion_scope": {
      "const": "real_planning_artifacts_only",
      "default": "real_planning_artifacts_only",
      "title": "Completion Scope",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/HermesStage"
      },
      "title": "Stages",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "discriminator": {
          "mapping": {
            "design": "#/$defs/HermesDesignArtifact",
            "plan": "#/$defs/HermesPlanArtifact",
            "requirements": "#/$defs/HermesRequirementsArtifact",
            "review": "#/$defs/HermesReviewArtifact"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/HermesRequirementsArtifact"
          },
          {
            "$ref": "#/$defs/HermesDesignArtifact"
          },
          {
            "$ref": "#/$defs/HermesPlanArtifact"
          },
          {
            "$ref": "#/$defs/HermesReviewArtifact"
          }
        ]
      },
      "title": "Artifacts",
      "type": "array"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Timeline",
      "type": "array"
    },
    "code_executed": {
      "const": false,
      "default": false,
      "title": "Code Executed",
      "type": "boolean"
    },
    "qa_verified": {
      "const": false,
      "default": false,
      "title": "Qa Verified",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "status",
    "version",
    "max_steps",
    "steps_done",
    "block_code",
    "reason",
    "owner_decision",
    "created_at",
    "updated_at",
    "stages",
    "artifacts",
    "timeline"
  ],
  "title": "HermesRunSnapshot",
  "type": "object"
}
