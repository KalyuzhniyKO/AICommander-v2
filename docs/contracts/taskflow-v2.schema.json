{
  "$defs": {
    "Design": {
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "$ref": "#/$defs/Requirements"
        },
        "components": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "requirements",
        "components"
      ],
      "title": "Design",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "integer"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "from_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunState"
            },
            {
              "type": "null"
            }
          ]
        },
        "to_status": {
          "$ref": "#/$defs/RunState"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "action",
        "from_status",
        "to_status",
        "version",
        "reason",
        "created_at"
      ],
      "title": "Event",
      "type": "object"
    },
