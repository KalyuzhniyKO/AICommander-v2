          "type": "integer"
        },
        "status": {
          "const": "completed",
          "default": "completed",
          "title": "Status",
          "type": "string"
        },
        "input_artifact_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Input Artifact Ids",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "redacted": {
          "const": true,
          "default": true,
          "title": "Redacted",
          "type": "boolean"
        },
        "simulated": {
          "const": false,
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        },
        "role": {
          "const": "architect",
          "title": "Role",
          "type": "string"
        },
        "type": {
          "const": "design",
          "title": "Type",
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/Design"
        },
        "provenance": {
          "$ref": "#/$defs/HermesProvenance"
        }
      },
      "required": [
        "artifact_id",
        "task_id",
        "run_id",
        "input_artifact_ids",
        "created_at",
        "role",
        "type",
        "content",
        "provenance"
      ],
      "title": "HermesDesignArtifact",
      "type": "object"
    },
