    "HermesStage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "analyst",
            "architect",
            "developer",
            "reviewer"
          ],
          "title": "Role",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/StageState"
        }
      },
      "required": [
        "role",
        "position",
        "status"
      ],
      "title": "HermesStage",
      "type": "object"
    },
    "PlanReview": {
      "additionalProperties": false,
      "properties": {
