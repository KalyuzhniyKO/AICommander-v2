    "HermesProvenance": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "const": "hermes",
          "default": "hermes",
          "title": "Origin",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "provider": {
          "const": "custom",
          "default": "custom",
          "title": "Provider",
          "type": "string"
        },
        "route": {
          "const": "omniroute",
          "default": "omniroute",
          "title": "Route",
          "type": "string"
        },
        "sdk_commit": {
          "title": "Sdk Commit",
          "type": "string"
        },
        "parent_session_id": {
          "title": "Parent Session Id",
          "type": "string"
        },
        "child_session_id": {
          "title": "Child Session Id",
          "type": "string"
        },
        "tools_count": {
          "const": 0,
          "default": 0,
          "title": "Tools Count",
          "type": "integer"
        },
        "inference_requests": {
          "const": 1,
          "default": 1,
          "title": "Inference Requests",
          "type": "integer"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "model_id",
        "sdk_commit",
        "parent_session_id",
        "child_session_id",
        "input_sha256"
      ],
      "title": "HermesProvenance",
      "type": "object"
    },
