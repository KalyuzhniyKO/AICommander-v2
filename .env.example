# Existing v2-compatible model transport only; real OmniRouter adapter is planned.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_TIMEOUT_SECONDS=60
# Total attempts per model, including the first call (minimum 1).
MAX_MODEL_RETRIES=1
DATABASE_URL=sqlite:///./aicommander.db

# Авторизация панели: пароль минимум 32 символа, только на сервере.
# Создать пароль: python -c "import secrets; print(secrets.token_urlsafe(32))"
PANEL_USER=owner
PANEL_PASSWORD=
